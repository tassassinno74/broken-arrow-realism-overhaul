<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BrokenArrowRealismOverhaul</AssemblyName>
    <RootNamespace>RealismOverhaul</RootNamespace>
    <Authors>tassassinno</Authors>
    <Company>tassassinno</Company>
    <Product>Broken Arrow Realism Overhaul</Product>
    <AssemblyTitle>Broken Arrow Realism Overhaul</AssemblyTitle>
    <Version>1.1</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>MSB3277;CS1701;CS1702;CS0618</NoWarn>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=src</PathMap>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- PUBLIC build for sharing: dotnet build -p:Public=true (compact log, short preference texts) -->
  <PropertyGroup Condition="'$(Public)'=='true'">
    <DefineConstants>$(DefineConstants);PUBLIC</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir>E:\SteamLibrary\steamapps\common\broken_arrow</GameDir>
    <ML>$(GameDir)\MelonLoader\net6</ML>
    <Il2Cpp>$(GameDir)\MelonLoader\Il2CppAssemblies</Il2Cpp>
    <NetRuntime>C:\Program Files\dotnet\shared\Microsoft.NETCore.App\6.0.11</NetRuntime>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="reel\*.csv" LogicalName="reel.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- .NET 6 runtime assemblies (no targeting-pack download) -->
    <Reference Include="$(NetRuntime)\System.*.dll" Exclude="$(NetRuntime)\System.IO.Compression.Native.dll" Private="false" />
    <Reference Include="$(NetRuntime)\netstandard.dll" Private="false" />
    <Reference Include="$(NetRuntime)\mscorlib.dll" Private="false" />

    <Reference Include="$(ML)\MelonLoader.dll" Private="false" />
    <Reference Include="$(ML)\0Harmony.dll" Private="false" />
    <Reference Include="$(ML)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(ML)\Il2CppInterop.Common.dll" Private="false" />

    <Reference Include="$(Il2Cpp)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\Il2CppSystem.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\Il2CppSystem.Core.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\Il2CppDefaultEcs.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\Il2CppNetworkCommon.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\Il2CppGalaxyCoreCommon.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\Il2CppSirenix.Serialization.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\Il2CppSirenix.OdinInspector.Attributes.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\Il2CppSirenix.Utilities.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\Il2CppGalaxyCoreLib.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\Il2CppUniTask.dll" Private="false" />
    <Reference Include="$(Il2Cpp)\Il2CppBrokenArrow.dll" Private="false" />
  </ItemGroup>
</Project>
